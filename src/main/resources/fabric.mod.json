{
  "schemaVersion": 1,
  "id": "bura",
  "version": "${version}",
  "name": "Bura",
  "description": "An experimental Fabric performance mod focused on smoother frame pacing, chunk scheduling, upload pacing, and visibility work.",
  "authors": [
    "EvoDevTeam",
    "GETGOODERKID"
  ],
  "contact": {
    "sources": "https://github.com/GETGOODERKID/bura"
  },
  "license": "MIT",
  "icon": "assets/bura/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "bura.com.Bura"
    ],
    "client": [
      "bura.com.BuraClient"
    ]
  },
  "mixins": [
    "bura.mixins.json",
    {
      "config": "bura.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
